# WEB 端口
VITE_WEB_PORT=14558
# API 端口
VITE_SERVER_PORT=25884
# API 地址 - 结尾不要加 /
VITE_API_URL=/api/netease
# 远程后端服务地址（授权校验/探活上报/自动更新）
# 自有后端地址的唯一来源：渲染进程经 import.meta.env.VITE_SERVER_URL 读取，
# 主进程构建期由 electron.vite.config.ts 静态注入 process.env.VITE_SERVER_URL，
# 代码中不保留任何硬编码兜底值；换域名只需修改此处（结尾不要加 /）
VITE_SERVER_URL=https://music.viaxv.cn
