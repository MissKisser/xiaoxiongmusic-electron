# ================================
# 服务器配置
# ================================

# 服务端口（默认：25884）
VITE_SERVER_PORT=25884

# 运行环境（development | production）
NODE_ENV=production

# ================================
# 数据库配置（可选）
# 如果不需要授权功能，可以不配置
# ================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=xiaoxiong_music

# ================================
# JWT 密钥（可选）
# 用于生成和验证 token
# ================================

JWT_SECRET=your_jwt_secret_here_change_in_production

# ================================
# 日志配置（可选）
# ================================

# 日志级别（info | debug | warn | error）
LOG_LEVEL=info
