    "scripts": {
      "format": "prettier --write .",
      "lint": "npx eslint . --fix",
      "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
      "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
      "typecheck": "npm run typecheck:node && npm run typecheck:web",
      "build:native": "tsx scripts/build-native.ts",
      "start": "electron-vite preview",
      "dev": "npm run build:native && tsx scripts/dev.ts",
      "web:dev": "npm run build:native && electron-vite dev --rendererOnly",
      "build": "rimraf dist && npm run build:native && npm run typecheck && electron-vite build",
      "build:web": "cross-env BUILD_TARGET=web rimraf dist out/renderer && npm run build:native && npm run typecheck && electron-vite build",
      "postinstall": "electron-builder install-app-deps",
      "build:unpack": "npm run build && electron-builder --dir",
      "build:win": "npm run build && electron-builder --win --config electron-builder.config.ts",
      "build:mac": "npm run build && electron-builder --mac --config electron-builder.config.ts",
      "build:linux": "npm run build && electron-builder --linux --config electron-builder.config.ts",
      "docs:dev": "vitepress dev docs",
      "docs:build": "vitepress build docs",
      "docs:preview": "vitepress preview docs",
      "server": "pnpm build:server && pnpm server:start",
      "server:prod": "pnpm build:server && pnpm server:start",
      "build:server": "tsc -p tsconfig.server.json",
      "server:start": "node out/server/start.js",
      "server:dev": "node --import tsx server/start.ts",
      "server:verify": "tsx server/verify.ts"
    }
  },
